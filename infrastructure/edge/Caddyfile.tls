# Automatic HTTPS via Let's Encrypt — __PHI_DOMAIN__ is replaced by configure-proxy.sh

__PHI_DOMAIN__ {
	# Do not gzip APKs. Android Chrome's download manager saves the compressed
	# bytes, then "Open" fails with "There was a problem parsing the package".
	@compressible {
		not path_regexp (?i)\.apk$
	}
	encode @compressible gzip

	handle /downloads/* {
		root * /var/phi/public
		@apk path_regexp (?i)\.apk$
		header @apk {
			Content-Type application/vnd.android.package-archive
			Content-Disposition "attachment"
			Cache-Control "no-transform"
			X-Content-Type-Options nosniff
		}
		file_server
	}

	handle /api/* {
		reverse_proxy localhost:8080
	}

	handle /actuator/* {
		reverse_proxy localhost:8080
	}

	handle {
		root * /var/phi/www
		try_files {path} /index.html
		file_server
	}
}

http://__PHI_DOMAIN__ {
	redir https://{host}{uri} permanent
}
