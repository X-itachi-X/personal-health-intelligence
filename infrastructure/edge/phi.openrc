#!/sbin/openrc-run

name="phi"
description="Personal Health Intelligence API"

command="/usr/bin/java"
command_args="-jar /var/phi/phi.jar"
command_background=true
supervisor=supervise-daemon
respawn_delay=2
respawn_max=0
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/phi/app.log"
error_log="/var/phi/app.log"

depend() {
    need net
    after firewall
}

start_pre() {
    for decrypt in /opt/phi-edge/decrypt-env.sh /opt/phi/infrastructure/edge/decrypt-env.sh; do
        if [ -f "$decrypt" ]; then
            # shellcheck source=/dev/null
            . "$decrypt"
            load_phi_env
            break
        fi
    done

    export SPRING_PROFILES_ACTIVE="${SPRING_PROFILES_ACTIVE:-prod}"

    checkpath -d -m 0755 -o dev:dev /var/phi/data /var/phi/reports /var/phi/backups
    checkpath -f -m 0644 -o dev:dev /var/phi/app.log
}
