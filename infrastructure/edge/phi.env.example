# Template only — NEVER copy plain to /etc/phi/env on the server.
# Encrypt with: infrastructure/edge/encrypt-env.sh this-file phi.age.pub
# Store on edge as: /etc/phi/env.age (see documentation/edge-secrets.md)
# Sourced by the phi OpenRC service and deploy/backup scripts.

SPRING_PROFILES_ACTIVE=prod

# Required for production
PHI_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
PHI_H2_PASSWORD=change-me-strong-h2-password
CLAUDE_API_KEY=

# Optional
CLAUDE_WORKSPACE_ID=
GOOGLE_CLIENT_ID=
PHI_PLATFORM_ADMIN_EMAILS=you@example.com

# Comma-separated origins for Expo dev + web (native apps ignore CORS).
# With Tailscale Funnel, web is same-origin — localhost is enough for dev.
PHI_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://edge-server.tail8a02ee.ts.net,http://192.168.1.71

# Optional: bought domain for Let's Encrypt (leave empty if using Tailscale Funnel)
PHI_DOMAIN=

# Ingest / storage (see documentation/00-engineering-principles.md)
PHI_RETAIN_FILES_DAYS=0
PHI_CLAUDE_AUTO_PARSE=true
PHI_CLAUDE_VISION_FALLBACK=false
PHI_OCR_ENABLED=true
PHI_OCR_LANGUAGES=eng+hin
