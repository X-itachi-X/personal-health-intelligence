# Local dev (PC): http://localhost:8080
# LAN testing:     http://192.168.1.71
# Public testers:  https://edge-server.YOUR-TAILNET.ts.net  (from install-tailscale-funnel.sh)
EXPO_PUBLIC_API_URL=http://192.168.1.71
# Use React Native fetch on device (optional fallback for file uploads)
EXPO_PUBLIC_USE_RN_FETCH=true
# Optional — Google Sign-In (create at console.cloud.google.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
