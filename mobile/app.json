{
  "expo": {
    "name": "Personal Health Intelligence",
    "slug": "personal-health-intelligence",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "phi",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e0ccc1b3-e9bc-4a97-aeee-345819d4eef6",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "android": {
      "package": "com.phi.health",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "@react-native-community/datetimepicker",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0ccc1b3-e9bc-4a97-aeee-345819d4eef6"
      }
    }
  }
}
